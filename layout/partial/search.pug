//- Search overlay (index: /content.json, generated by hexo-generator-json-content)
.search-modal#search-modal(role="dialog" aria-modal="true" aria-labelledby="search-title" data-index=url_for('content.json') hidden)
    .search-backdrop(data-search-close)
    .search-panel
        .search-header
            h2.search-title#search-title Search
            button.search-close(type="button" aria-label="Close search" data-search-close) ×
        form.search-form(role="search" onsubmit="return false")
            input.search-input#search-input(type="search" placeholder="Search posts and projects …" autocomplete="off" spellcheck="false" aria-label="Search posts and projects")
        p.search-hint Type to filter by title, tag or full text. Press Esc to close.
        ul.search-results#search-results
        p.search-empty#search-empty(hidden) Nothing found.
