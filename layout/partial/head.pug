meta(charset="utf-8")
meta(name="X-UA-Compatible", content="IE=edge")

title 
    block site_title
        = config.title
block description
    meta(name="description", content= config.description ? config.description : 'Description here')

meta(name="viewport", content="width=device-width, initial-scale=1")
link(rel="icon", href=url_for(theme.favicon))
link(rel="stylesheet", href=url_for("css/hermes.css"))
link(rel="stylesheet", href=url_for("css/katex.min.css"))
link(rel="stylesheet", href=url_for("css/github-markdown.css"))

//- Preload fonts (latin subset, self-hosted variable font)
link(rel="preload" href="/fonts/cabin-normal-400.woff2" as="font" type="font/woff2" crossorigin)
link(rel="preload" href="/fonts/cabin-italic-400.woff2" as="font" type="font/woff2" crossorigin)

- var xml = config.url + '/atom.xml'
    link(rel="search", type="application/opensearchdescription+xml", href=xml, title=config.title)
    
