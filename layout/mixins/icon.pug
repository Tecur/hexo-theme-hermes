//- Inline SVG icons for the icon-only navigation entries.
//- Keep the glyphs inside a 1em box so they match the menu text size.
mixin menu-icon(name)
    - var icon = (name || '').toLowerCase()
    case icon
        when 'github'
            svg.nav-icon(viewBox="0 0 16 16" aria-hidden="true" focusable="false")
                path(fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z")
        when 'feed'
            svg.nav-icon(viewBox="3.5 3.5 17 17" aria-hidden="true" focusable="false")
                path(fill="currentColor" d="M4 4a16 16 0 0 1 16 16h-3.2A12.8 12.8 0 0 0 4 7.2V4Zm0 6.4a9.6 9.6 0 0 1 9.6 9.6h-3.2A6.4 6.4 0 0 0 4 13.6v-3.2Z")
                circle(cx="6.5" cy="17.5" r="2.5" fill="currentColor")
        when 'search'
            svg.nav-icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
                circle(cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M15.5 15.5 21 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")
        default
            span.nav-icon-fallback= name
